# Your Shiprocket tracking page, for example:
# SHIPROCKET_TRACKING_URL=https://shiprocket.co/tracking/SRSP1234567890
SHIPROCKET_TRACKING_URL=
POLL_INTERVAL_SECONDS=900
SEND_INITIAL_UPDATE=false
STOP_ON_TERMINAL_STATUS=true
TERMINAL_STATUSES=delivered,delivery completed,rto delivered
REPLY_TO_GROUP_STATUS_REQUESTS=true
STATUS_REQUEST_COOLDOWN_SECONDS=90
STATUS_REQUEST_PHRASES=current status,shipment status,delivery status,package status,status update,track package,track shipment,where is the package,where is my package,where is shipment,where is the shipment

# Use "whatsapp" to send to a WhatsApp group. Use "dry-run" to only print messages.
BOT_MODE=whatsapp

# Prefer WHATSAPP_GROUP_ID after running: npm run groups
# Example group ids look like: 120363000000000000@g.us
WHATSAPP_GROUP_ID=

# Optional fallback if WHATSAPP_GROUP_ID is empty. Must match the group name exactly.
WHATSAPP_GROUP_NAME=

STATE_FILE=data/state.json
WHATSAPP_AUTH_DIR=.wwebjs_auth
WHATSAPP_READY_TIMEOUT_SECONDS=300
WHATSAPP_SEND_ACK_TIMEOUT_SECONDS=90
HEADLESS=true

# Optional. The bot can auto-detect Chrome or Edge on Windows, but set this if needed.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
